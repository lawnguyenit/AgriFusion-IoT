FIREBASE_KEY_PATH="../Secrets/Firebase/service-account.json"
DATABASE_URL="https://YOUR_PROJECT-default-rtdb.REGION.firebasedatabase.app"
FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
FIREBASE_LEGACY_TOKEN="YOUR_FIREBASE_LEGACY_TOKEN"

EXPORT_SOURCE=firebase
EXPORT_INPUT_JSON=
EXPORT_NODE_ID=Node1
EXPORT_NODE_SLUG=node1
EXPORT_TIMEZONE=Asia/Ho_Chi_Minh
EXPORT_PRIMARY_POLL_AFTER_SEC=900
EXPORT_RETRY_AFTER_NO_CHANGE_SEC=300
EXPORT_NO_CHANGE_RETRY_LIMIT=1

EXPORT_NPK_SENSOR_ID=npk_7in1_1
EXPORT_NPK_SENSOR_TYPE=npk7in1
EXPORT_SHT30_SENSOR_ID=sht30_1
EXPORT_SHT30_SENSOR_TYPE=sht30_air
