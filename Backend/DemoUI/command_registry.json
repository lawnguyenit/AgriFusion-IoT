{
  "stages": [
    {
      "id": "ingestion",
      "title": "1. Data Ingestion / Firebase -> Layer0",
      "role": "Keo du lieu telemetry tho tu Firebase ve local Layer0.",
      "inputs": [
        "Firebase RTDB telemetry",
        "Backend/main.py"
      ],
      "outputs": [
        "Backend/Output_data/Layer0/Firebase_data/history",
        "Backend/Output_data/Layer0/Firebase_data/new_raw/latest.json"
      ],
      "warning": "",
      "status_note": "Tap trung vao raw telemetry va lich su dong bo."
    },
    {
      "id": "layer1",
      "title": "2. Telemetry Normalization / Layer0 -> Layer1",
      "role": "Chuan hoa raw telemetry thanh snapshot sensor va memory windows.",
      "inputs": [
        "Layer0 raw artifacts"
      ],
      "outputs": [
        "Backend/Output_data/Layer1/sht30",
        "Backend/Output_data/Layer1/npk",
        "Backend/Output_data/Layer1/meteo"
      ],
      "warning": "",
      "status_note": "Day la buoc tien xu ly, khong phai benchmark model."
    },
    {
      "id": "aligned_table",
      "title": "3. Aligned Benchmark Table",
      "role": "Can chinh Layer1 theo thoi gian de tao bang benchmark nen chua gan nhan.",
      "inputs": [
        "Layer1 histories"
      ],
      "outputs": [
        "Backend/Benchmark/benchmark_dataset/dataset/benchmark_input_aligned.csv"
      ],
      "warning": "",
      "status_note": "Bang nay la benchmark nen, chua co weak label."
    },
    {
      "id": "weak_labeling",
      "title": "4. Weak Labeling & Label Audit",
      "role": "Gan nhan yeu tu rule telemetry va metadata van hanh.",
      "inputs": [
        "benchmark_input_aligned.csv",
        "Layer0 Firebase metadata"
      ],
      "outputs": [
        "Backend/Benchmark/benchmark_dataset/dataset/benchmark_input_labeled.csv",
        "Backend/Benchmark/benchmark_dataset/dataset/benchmark_labeling_report.json"
      ],
      "warning": "Labels are weak/heuristic labels generated from telemetry rules and operational context. They are not independent agronomic ground truth.",
      "status_note": "Khong duoc dien giai nhan nay nhu ground truth nong hoc doc lap."
    },
    {
      "id": "feature_engineering",
      "title": "5. Feature Engineering / v0, v1, v2",
      "role": "Tao cac benchmark feature set theo muc tieu ablation va temporal window.",
      "inputs": [
        "benchmark_input_aligned.csv",
        "benchmark_input_labeled.csv"
      ],
      "outputs": [
        "v0: benchmark_input_aligned.csv",
        "v1: benchmark_input_aligned.csv subset",
        "v2: single_window_exp2.csv"
      ],
      "warning": "v2 co the hoc lai mot phan logic rule neu rule gan nhan cung dua vao bien dong telemetry.",
      "status_note": "UI map v0/v1/v2 theo raw_tabular_source_registry dang active trong repo."
    },
    {
      "id": "temporal_split",
      "title": "6. Temporal Split / Train-Validation-Test",
      "role": "Chuan bi dataset theo thoi gian va kiem tra coverage lop hiem.",
      "inputs": [
        "benchmark_input_labeled.csv",
        "feature exports"
      ],
      "outputs": [
        "Backend/Benchmark/tabular_benchmark/artifacts/<lane>/datasets/<run_id>"
      ],
      "warning": "",
      "status_note": "Split active dung temporal split, khong shuffle."
    },
    {
      "id": "benchmarking",
      "title": "7. Model Benchmarking",
      "role": "Train telemetry classification benchmark for research comparison and model evaluation.",
      "inputs": [
        "Prepared tabular benchmark runs"
      ],
      "outputs": [
        "Backend/Benchmark/tabular_benchmark/artifacts/<lane>/training/<run_id>"
      ],
      "warning": "Model nay chi benchmark kha nang khai thac telemetry theo nhan yeu, khong phai he thong ra quyet dinh canh tac.",
      "status_note": "Dung ngon ngu benchmark result / telemetry classification / model evaluation."
    },
    {
      "id": "report_publish",
      "title": "8. Report & Dashboard Publish",
      "role": "Tong hop metrics, chart va day ket qua len dashboard web.",
      "inputs": [
        "Training outputs",
        "Layer1 result artifacts"
      ],
      "outputs": [
        "Backend/Benchmark/tabular_benchmark/artifacts/<lane>/reports/<run_id>",
        "Firebase result branch"
      ],
      "warning": "",
      "status_note": "Repo hien tai sinh report markdown + PNG; khong tuyen bo co HTML/PDF neu artifact do chua ton tai."
    },
    {
      "id": "defense_backup",
      "title": "9. Audit & Defense",
      "role": "Tong hop cac checklist va artifact de bao ve khoa luan.",
      "inputs": [
        "Feature schemas",
        "Weak-label outputs",
        "Split reports",
        "Training reports"
      ],
      "outputs": [
        "Defense audit text summary",
        "Latest schema / checklist snapshots"
      ],
      "warning": "Can nhan manh proxy leakage gian tiep van co the ton tai du da loai bo label columns truc tiep.",
      "status_note": "Panel nay phuc vu hoi dong hoi ve leakage, labels, split va limitation."
    }
  ],
